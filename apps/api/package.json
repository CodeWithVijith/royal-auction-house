{
  "name": "@sports/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup src/server.ts --format esm --platform node --target node22 --no-splitting",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@node-rs/argon2": "^2.2.2",
    "@sports/db": "workspace:*",
    "@sports/shared": "workspace:*",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "mongodb": "^7.7.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.3",
    "yauzl": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/yauzl": "^3.4.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0"
  }
}
