# Atlas: replace placeholders with your database user and URL-encoded password.
# Keep completed credentials in ignored .env or Render environment variables.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.ibfyqg4.mongodb.net/?compressors=zlib
MONGODB_DB_NAME=sports_auction
# Local Docker alternative:
# MONGODB_URI=mongodb://127.0.0.1:27017/sports_auction?replicaSet=rs0&directConnection=true
API_PORT=4000
# Render provides PORT automatically and it takes precedence over API_PORT.
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000
# Public WebSocket backend origin; Render supplies RENDER_EXTERNAL_URL automatically.
PUBLIC_API_URL=http://localhost:4000
# Actual MongoDB image storage is the local/default option. Use s3 for S3/R2.
STORAGE_DRIVER=mongodb
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
